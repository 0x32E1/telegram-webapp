BOT_TOKEN=123456:your_bot_token_from_botfather
ADMIN_IDS=123456789,987654321
DB_PATH=salon.db

# Public HTTPS URL where this app will be reachable (e.g. via ngrok or a real domain).
# Telegram requires HTTPS for Mini Apps - http://localhost will NOT work inside Telegram.
WEBAPP_URL=https://your-domain-or-ngrok-url.example.com

# Set to true ONLY for local design review in a plain desktop browser (skips Telegram's
# signature check). Never enable this on anything the public can reach.
DEV_MODE=false
